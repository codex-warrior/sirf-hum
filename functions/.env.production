# Non-secret parameters for the production environment (loaded by the Firebase CLI
# when deploying with --project production). Secrets use defineSecret / Secret Manager.
SH_ENV=production
# D-152 (owner, temporary): callables accept requests without an App Check
# token until the app is linked in Play Console. Remove this line to restore
# enforcement, then redeploy Functions.
SH_APP_CHECK_PAUSED=true
# D-159 (owner, temporary, friends beta only): an identity reset takes effect
# after 1 hour instead of 7 days, so a tester who uninstalled the app can set
# their phone up again the same day. Remove this line to restore 7 days, then
# redeploy Functions. Must be removed before any public launch.
SH_IDENTITY_RESET_DELAY_HOURS=1
