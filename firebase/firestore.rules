rules_version = '2';

// Sirf Hum Firestore rules.
//
// Default: deny everything. Access is opened per collection, in the phase
// that introduces it, together with emulator tests in firebase/tests/.
// Never widen these rules to make a client feature work; fix the data model
// or move the operation to a Cloud Function.
// See docs/architecture/FIREBASE-ARCHITECTURE.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Device registry and account trust (Prompts 07–09,
    // docs/security/DEVICE-IDENTITY.md, docs/security/MULTI-DEVICE-TRUST.md).
    //
    // Records are public, server-visible metadata. They are a directory,
    // never proof of trust: devices verify the signed evidence on them
    // themselves (D-084). EVERY write is server-only (Cloud Functions,
    // Admin SDK): registration, activation, approval, recovery, signed
    // revocation (D-081), identity reset (D-082), trust epochs (D-083).
    // Firebase Auth alone never creates, extends or removes device trust.
    //
    // Clients may only read their own records. Server-only collections
    // (deviceChallenges, deviceApprovalRequests, deviceIdIndex,
    // deviceKeyIndex, rateLimits) stay default-deny.
    match /users/{accountId}/devices/{deviceId} {
      allow read: if isAccountOwner(accountId);
      allow write: if false;
    }

    // The owner reads the trust epoch, reset status and the recovery key's
    // PUBLIC half to verify freshness (D-083) and lineage (D-084).
    match /accountTrust/{accountId} {
      allow read: if isAccountOwner(accountId);
      allow write: if false;
    }

    function isAccountOwner(accountId) {
      return request.auth != null && request.auth.uid == accountId;
    }
  }
}
