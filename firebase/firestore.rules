rules_version = '2';

// Sirf Hum Firestore rules.
//
// Default: deny everything. Access is opened per collection, in the phase
// that introduces it, together with emulator tests in firebase/tests/.
// Never widen these rules to make a client feature work; fix the data model
// or move the operation to a Cloud Function.
// See docs/architecture/FIREBASE-ARCHITECTURE.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Device registry and account trust (Prompts 07–09,
    // docs/security/DEVICE-IDENTITY.md, docs/security/MULTI-DEVICE-TRUST.md).
    //
    // Records are public, server-visible metadata. They are a directory,
    // never proof of trust: devices verify the signed evidence on them
    // themselves (D-084). EVERY write is server-only (Cloud Functions,
    // Admin SDK): registration, activation, approval, recovery, signed
    // revocation (D-081), identity reset (D-082), trust epochs (D-083).
    // Firebase Auth alone never creates, extends or removes device trust.
    //
    // Clients read their own records and, once a couple is provisioned
    // (D-086), their partner's: public material only, needed to verify the
    // partner's lineage on their own device. Server-only collections
    // (deviceChallenges, deviceApprovalRequests, deviceIdIndex,
    // deviceKeyIndex, rateLimits) stay default-deny.
    match /users/{accountId}/devices/{deviceId} {
      allow read: if isAccountOwner(accountId) || isPartnerOf(accountId);
      allow write: if false;
    }

    // The trust epoch, reset status and the recovery key's PUBLIC half, to
    // verify freshness (D-083) and lineage (D-084). Owner and partner read.
    match /accountTrust/{accountId} {
      allow read: if isAccountOwner(accountId) || isPartnerOf(accountId);
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Private messaging (Prompt 10, docs/security/E2EE-MESSAGING-DESIGN.md).
    //
    // Firebase authorizes access to CIPHERTEXT, per account. MLS decides
    // which devices hold keys. Nothing here parses or validates MLS bytes.
    //
    //   pairings/*          server-only (future pairing phase): default deny
    //   accountPartners/*   server-only; owner read (D-086)
    //   conversations/*     server-created; members read; clients may only
    //                       move `epoch` by one, with that epoch's commit
    //   .../keyPackages/*   a member publishes for one of its active devices
    //   .../commits/{e}     create-only, one per epoch: first wins (D-088)
    //   .../welcomes/*      create-only, only beside their accepted commit
    //   .../messages/*      create-only ciphertext at the current epoch
    //
    // Clients can never edit or delete commits, Welcomes or messages:
    // retention and server deletion are deferred server decisions.
    match /accountPartners/{accountId} {
      allow read: if isAccountOwner(accountId);
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isMember(conversationId);
      allow create, delete: if false;
      // The epoch counter only, by exactly one, and only in the same batch
      // as the (new) commit for the old epoch, which its own rule validates.
      allow update: if isMember(conversationId)
        && resource.data.state == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['epoch'])
        && request.resource.data.epoch == resource.data.epoch + 1
        && !exists(commitPath(conversationId, resource.data.epoch))
        && existsAfter(commitPath(conversationId, resource.data.epoch));

      match /keyPackages/{deviceId} {
        allow read: if isMember(conversationId);
        allow create: if validKeyPackage(conversationId, deviceId);
        allow update: if validKeyPackage(conversationId, deviceId)
          && resource.data.accountId == request.auth.uid;
        allow delete: if isMember(conversationId)
          && resource.data.accountId == request.auth.uid;
      }

      match /commits/{epoch} {
        allow read: if isMember(conversationId);
        allow create: if validCommit(conversationId, epoch);
        allow update, delete: if false;
      }

      match /welcomes/{welcomeId} {
        allow read: if isMember(conversationId);
        allow create: if validWelcome(conversationId, welcomeId);
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isMember(conversationId);
        allow create: if validMessage(conversationId, messageId);
        allow update, delete: if false;
      }
    }

    function isAccountOwner(accountId) {
      return request.auth != null && request.auth.uid == accountId;
    }

    function isPartnerOf(accountId) {
      let partners = /databases/$(database)/documents/accountPartners/$(request.auth.uid);
      return request.auth != null
        && exists(partners)
        && get(partners).data.partnerAccountId == accountId;
    }

    function conversation(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function isMember(conversationId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in conversation(conversationId).members;
    }

    // The writer is a member of an active conversation, writing as one of
    // their OWN devices that the server lists as active right now (never a
    // revoked, pending, rejected or expired one).
    function isActiveMemberDevice(conversationId, deviceId) {
      let conv = conversation(conversationId);
      let device = /databases/$(database)/documents/users/$(request.auth.uid)/devices/$(deviceId);
      return isMember(conversationId)
        && conv.state == 'active'
        && deviceId is string
        && deviceId.matches('^[0-9a-f]{32}$')
        && exists(device)
        && get(device).data.status == 'active';
    }

    function commitPath(conversationId, epoch) {
      return /databases/$(database)/documents/conversations/$(conversationId)/commits/$(string(epoch));
    }

    function validKeyPackage(conversationId, deviceId) {
      let d = request.resource.data;
      return isActiveMemberDevice(conversationId, deviceId)
        && d.keys().hasOnly(['schemaVersion', 'accountId', 'deviceId', 'keyPackage', 'updatedAt'])
        && d.keys().hasAll(['schemaVersion', 'accountId', 'deviceId', 'keyPackage', 'updatedAt'])
        && d.schemaVersion == 1
        && d.accountId == request.auth.uid
        && d.deviceId == deviceId
        && d.keyPackage is bytes
        && d.keyPackage.size() > 0
        && d.keyPackage.size() <= 16384
        && d.updatedAt == request.time;
    }

    function validCommit(conversationId, epoch) {
      let d = request.resource.data;
      let before = conversation(conversationId);
      let after = getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data;
      return isActiveMemberDevice(conversationId, d.senderDeviceId)
        && d.keys().hasOnly(['schemaVersion', 'epoch', 'senderAccountId', 'senderDeviceId', 'commit', 'createdAt'])
        && d.keys().hasAll(['schemaVersion', 'epoch', 'senderAccountId', 'senderDeviceId', 'commit', 'createdAt'])
        && d.schemaVersion == 1
        && d.epoch is int
        && d.epoch == before.epoch
        && epoch == string(before.epoch)
        && after.epoch == before.epoch + 1
        && d.senderAccountId == request.auth.uid
        && d.commit is bytes
        && d.commit.size() > 0
        && d.commit.size() <= 131072
        && d.createdAt == request.time;
    }

    function validWelcome(conversationId, welcomeId) {
      let d = request.resource.data;
      let commit = commitPath(conversationId, d.epoch);
      return isActiveMemberDevice(conversationId, d.senderDeviceId)
        && d.keys().hasOnly(['schemaVersion', 'epoch', 'targetDeviceId', 'senderAccountId', 'senderDeviceId', 'welcome', 'createdAt'])
        && d.keys().hasAll(['schemaVersion', 'epoch', 'targetDeviceId', 'senderAccountId', 'senderDeviceId', 'welcome', 'createdAt'])
        && d.schemaVersion == 1
        && d.epoch is int
        && d.epoch == conversation(conversationId).epoch
        && d.targetDeviceId is string
        && d.targetDeviceId.matches('^[0-9a-f]{32}$')
        && welcomeId == d.targetDeviceId + '_' + string(d.epoch)
        && d.senderAccountId == request.auth.uid
        // Only beside its own commit, created in this same batch.
        && !exists(commit)
        && existsAfter(commit)
        && getAfter(commit).data.senderDeviceId == d.senderDeviceId
        && d.welcome is bytes
        && d.welcome.size() > 0
        && d.welcome.size() <= 131072
        && d.createdAt == request.time;
    }

    function validMessage(conversationId, messageId) {
      let d = request.resource.data;
      return isActiveMemberDevice(conversationId, d.senderDeviceId)
        && messageId.matches('^[0-9a-f]{32}$')
        && d.keys().hasOnly(['schemaVersion', 'protocolVersion', 'senderAccountId', 'senderDeviceId', 'epoch', 'ciphertext', 'serverTime'])
        && d.keys().hasAll(['schemaVersion', 'protocolVersion', 'senderAccountId', 'senderDeviceId', 'epoch', 'ciphertext', 'serverTime'])
        && d.schemaVersion == 1
        && d.protocolVersion == 1
        && d.senderAccountId == request.auth.uid
        && d.epoch is int
        && d.epoch >= 1
        && d.epoch == conversation(conversationId).epoch
        && d.ciphertext is bytes
        && d.ciphertext.size() > 0
        && d.ciphertext.size() <= 32768
        && d.serverTime == request.time;
    }
  }
}
