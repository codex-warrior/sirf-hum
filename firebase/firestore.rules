rules_version = '2';

// Sirf Hum Firestore rules.
//
// Default: deny everything. Access is opened per collection, in the phase
// that introduces it, together with emulator tests in firebase/tests/.
// Never widen these rules to make a client feature work; fix the data model
// or move the operation to a Cloud Function.
// See docs/architecture/FIREBASE-ARCHITECTURE.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Device registry (Prompts 07–08, docs/security/DEVICE-IDENTITY.md).
    //
    // A record is public, server-visible metadata about one device of one
    // account. It is a directory entry, never proof of trust. Every write
    // that creates or extends trust is server-only (Cloud Functions, Admin
    // SDK): registration (rate-limited, certificate verified), first-device
    // activation, approval by a trusted device, recovery. Firebase Auth
    // alone never makes a device trusted.
    //
    // Clients may only:
    //   - read their own records;
    //   - revoke their own record (pending/active -> revoked, one way).
    // Nobody may create or delete a record from a client, so a revoked
    // device ID can never be re-created and re-activated. Terminal states
    // (revoked, rejected, expired) can never change. Server-only
    // collections (accountTrust, deviceChallenges, deviceApprovalRequests,
    // deviceIdIndex, deviceKeyIndex, rateLimits) stay default-deny.
    match /users/{accountId}/devices/{deviceId} {
      allow read: if isAccountOwner(accountId);
      allow create: if false;
      allow update: if isAccountOwner(accountId) && isValidSelfRevocation();
      allow delete: if false;
    }

    function isAccountOwner(accountId) {
      return request.auth != null && request.auth.uid == accountId;
    }

    // The owner may retire a device; nothing else about the record changes,
    // and a revoked record can never change again.
    function isValidSelfRevocation() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status in ['pending', 'active']
        && after.status == 'revoked'
        && after.diff(before).affectedKeys().hasOnly(['status', 'revokedAt', 'revokedReason'])
        && after.revokedAt == request.time
        && after.revokedReason == 'user_removed';
    }
  }
}
